{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "emmet.includeLanguages": {
    "html": "html"
  },
  "liveServer.settings.port": 5500,
  "liveServer.settings.CustomBrowser": "chrome",
  "search.exclude": {
    "**/.vercel": true,
    "**/.netlify": true,
    "**/node_modules": true
  },
  "files.associations": {
    "*.html": "html"
  }
}
